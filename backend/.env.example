# Copy to backend/.env for local development:  cp .env.example .env
# Load it with:  uvicorn app.main:app --reload --env-file .env
# On Render, set these in the service's Environment tab instead (never commit .env).

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated exact frontend origins allowed by CORS. Wildcards are rejected.
# REQUIRED when APP_ENV=production (e.g. https://your-site.netlify.app)
CORS_ORIGINS=http://localhost:5173

# --- Added in later phases (not read yet) ---
# Phase 3: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (server only), SUPABASE_JWT_SECRET
# Phase 5: GEMINI_API_KEY (server only)
