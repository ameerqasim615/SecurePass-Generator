# Copy to frontend/.env for local development:  cp .env.example .env
# On Netlify, set these under Site configuration -> Environment variables.
# Everything prefixed VITE_ is bundled into public browser code: NEVER put secrets here.

# Base URL of the FastAPI backend (no trailing slash needed).
VITE_API_BASE_URL=http://localhost:8000

